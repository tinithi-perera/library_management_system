<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import java.net.URL?>

<AnchorPane prefHeight="487.0" prefWidth="685.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.AddBookController">
    <stylesheets>
        <URL value="@/style.css" />
    </stylesheets>
   <children>
      <Label layoutX="281.0" layoutY="48.0" prefHeight="35.0" prefWidth="146.0" text="ADD BOOK">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font>
      </Label>
      <Label layoutX="94.0" layoutY="135.0" prefHeight="22.0" prefWidth="102.0" text="BOOK ID / ISBN :" />
      <TextField fx:id="txtBookId" layoutX="197.0" layoutY="134.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="94.0" layoutY="166.0" prefHeight="22.0" prefWidth="87.0" text="BOOK TITLE:" />
      <TextField fx:id="txtBookTitle" layoutX="197.0" layoutY="164.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="94.0" layoutY="200.0" prefHeight="22.0" prefWidth="72.0" text="AUTHOR:" />
      <TextField fx:id="txtAuthor" layoutX="197.0" layoutY="198.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="94.0" layoutY="239.0" text="CATEGORY:" />
      <ComboBox fx:id="cmbCategory" layoutX="197.0" layoutY="235.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="94.0" layoutY="280.0" prefHeight="18.0" prefWidth="102.0" text="PUBLISHED YEAR:" />
      <TextField fx:id="txtPublishedYear" layoutX="198.0" layoutY="277.0" prefHeight="26.0" prefWidth="283.0" />
      <Label layoutX="94.0" layoutY="323.0" prefHeight="18.0" prefWidth="87.0" text="QUANTITY:" />
      <TextField fx:id="txtQuantity" layoutX="196.0" layoutY="319.0" prefHeight="26.0" prefWidth="283.0" />
      <Button fx:id="btnAddBook" layoutX="140.0" layoutY="381.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="26.0" prefWidth="112.0" text="Add Book" />
      <Button fx:id="btnClear" layoutX="308.0" layoutY="381.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="26.0" prefWidth="112.0" text="Clear" />
      <Button fx:id="btnBack" layoutX="516.0" layoutY="381.0" mnemonicParsing="false" onAction="#btnBackOnAction" prefHeight="18.0" prefWidth="81.0" text="Back" />
   </children>
</AnchorPane>
